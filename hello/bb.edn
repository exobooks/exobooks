{:tasks
 {run  {:doc "Run from source on the machine's Java"
        :override-builtin true
        :task (clojure "-M:run")}
  uber {:doc "Build target/exobooks.jar"
        :task (clojure "-T:build" "uber")}
  check {:doc "Build, then run the jar with plain `java -jar`"
         :depends [uber]
         :task (shell "java" "-jar" "target/exobooks.jar")}
  release {:doc "Publish the jar as a GitHub release: bb release <tag>, e.g. bb release hello-0.1.0"
           :depends [uber]
           :task (let [tag (or (first *command-line-args*) (throw (ex-info "tag?" {})))]
                   (shell "gh" "release" "create" tag "target/exobooks.jar"
                          "--repo" "exobooks/exobooks"
                          "--title" tag
                          "--notes" (str "A hello-world jar that checks whether a machine can run exobooks: it needs Java "
                                         (clojure.string/trim (slurp "../.java-version"))
                                         ", and loads SQLite through the FFM API. See the README.")))}}}
